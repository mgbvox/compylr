//! Translated from Python by compylr.

use std::collections::{HashMap, HashSet};

use crate::compat::{
    PyAdd, PyContains, PyIterate, PyLen, PyNum, PySetItem, RuntimeError, py_subscript,
    py_truediv,
};

pub fn at_most(a: i64, b: i64) -> Result<bool, RuntimeError> {
    Ok(((&(a)) <= (&(b))))
}

pub fn differs(a: i64, b: i64) -> Result<bool, RuntimeError> {
    Ok(((&(a)) != (&(b))))
}

pub fn greeting() -> Result<String, RuntimeError> {
    Ok(String::from("hello"))
}

pub fn is_even(n: i64) -> Result<bool, RuntimeError> {
    Ok(((&(PyNum::py_mod(&(n), &(2i64))?)) == (&(0i64))))
}

pub fn nothing() -> Result<(), RuntimeError> {
    Ok(())
}

pub fn truthy() -> Result<bool, RuntimeError> {
    Ok(true)
}
