//! Translated by compylr.

use std::collections::{HashMap, HashSet};

use crate::compat::{
    PyAdd, PyContains, PyIterate, PyLen, PyNum, PySetItem, RuntimeError, div_exact,
    py_subscript,
};

pub fn halves(a: i64) -> Result<i64, RuntimeError> {
    Ok(PyNum::div_floor(&(a), &(2i64))?)
}

pub fn ratio(a: i64, b: i64) -> Result<f64, RuntimeError> {
    Ok(div_exact(&(((a) as f64)), &(((b) as f64)))?)
}

pub fn remainder(a: i64, b: i64) -> Result<i64, RuntimeError> {
    Ok(PyNum::rem_floor(&(a), &(b))?)
}
