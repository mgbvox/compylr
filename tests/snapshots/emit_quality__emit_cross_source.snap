use super::runtime::{PyAdd, PyNum, RuntimeError, py_truediv};

    pub fn caller(n: i64) -> Result<i64, RuntimeError> {
        Ok(remote_helper(n)?)
    }

    pub fn remote_helper(n: i64) -> Result<i64, RuntimeError> {
        Ok(PyAdd::py_add(&(n), &(1i64))?)
    }

}
