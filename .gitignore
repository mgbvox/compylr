context/
.codex/
.agent/
.agents/
.claude/
worktrees/
/scratch
# Build output
/target

# Generated compilation artifacts: the IR, the emitted target source, the shared
# generated crate, and the build state. Regenerated from source on demand.
.compylr/

# ...except the demo's IR and crate, which are committed so the emitted Rust can be read
# on GitHub without installing a toolchain.
#
# The shape below is not stylistic. Git never descends into an excluded *directory*, so a
# `!` rule beneath one can never match -- `.compylr/` above would swallow the whole tree no
# matter what followed. So the directory is re-included first, then its contents are
# excluded, then the two wanted subtrees are re-included one level at a time. Every
# intermediate directory has to be walkable for the rule under it to be reachable.
!demo/demo-python-rust/.compylr/
demo/demo-python-rust/.compylr/*
!demo/demo-python-rust/.compylr/crate/
!demo/demo-python-rust/.compylr/ir/

!demo/demo-ts-go/.compylr/
demo/demo-ts-go/.compylr/*
!demo/demo-ts-go/.compylr/go/
!demo/demo-ts-go/.compylr/ir/
demo/demo-ts-go/.compylr/lib/

# The build output under the committed crate, which is ~64M and rebuilt on demand.
demo/demo-python-rust/.compylr/crate/target/
*.so
*.pyd
/dist
/wheels

# Secrets — never commit
.env
.env.*
!.env.example

# Python bytecode
__pycache__/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
/.venv

# Editor / OS
.idea/
.DS_Store

# Machine-local Claude Code settings (skills and commands ARE committed)
.claude/settings.local.json

# The demo's own environment. Its .compylr is handled above.
demo/demo-python-rust/.venv/
node_modules/
demo/demo-ts-go/dist/
demo/demo-python-rust/uv.lock
