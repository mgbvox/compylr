//! Translated by compylr.

use crate::compat::{
    FastMap, FastSet, IndexOrigin, PyAdd, PyAddAssign, PyAddAssignAt, PyContains,
    PyIterate, PyLen, PyNum, PySetItem, RuntimeError, TextUnits, div_exact,
    py_borrow, py_place, py_str_add, py_str_owned, py_subscript,
};

pub fn counts(words: Vec<String>) -> Result<FastMap<String, i64>, RuntimeError> {
    let mut seen: FastMap<String, i64> = FastMap::from_iter([]);
    {
        let __compylr_iter = &words;
        for __compylr_item in PyIterate::py_iter_borrowed(__compylr_iter) {
            let word: &String = __compylr_item;
            if PyContains::py_contains(&(seen), &(word)) {
                {
                    let __compylr_delta = 1i64;
                    let __compylr_index = Clone::clone(&(word));
                    PyAddAssignAt::py_add_assign_at(&mut (seen), &__compylr_index, &__compylr_delta, IndexOrigin::FromEitherEnd)?;
                }
            } else {
                {
                    let __compylr_value = 1i64;
                    let __compylr_index = Clone::clone(&(word));
                    PySetItem::py_set(&mut (seen), &__compylr_index, __compylr_value)?;
                }
            }
        }
    }
    Ok(seen)
}

pub fn evens_below(limit: i64) -> Result<Vec<i64>, RuntimeError> {
    let mut found: Vec<i64> = Vec::with_capacity(usize::try_from(limit).unwrap_or(0));
    {
        let __compylr_stop: i64 = limit;
        let __compylr_step: i64 = 1i64;
        if __compylr_step == 0 {
            return Err(RuntimeError::ZeroStep);
        }
        let mut __compylr_cursor: i64 = 0i64;
        while (__compylr_step > 0 && __compylr_cursor < __compylr_stop)
            || (__compylr_step < 0 && __compylr_cursor > __compylr_stop)
        {
            let n: i64 = __compylr_cursor;
            __compylr_cursor = PyAdd::py_add(&(__compylr_cursor), &(__compylr_step))?;
            if ((&(PyNum::rem_floor(&(n), &(2i64))?)) == (&(0i64))) {
                {
                    let __compylr_value = Clone::clone(&(n));
                    (found).push(__compylr_value);
                }
            }
        }
    }
    Ok(found)
}

pub fn has_element(xs: Vec<i64>, x: i64) -> Result<bool, RuntimeError> {
    Ok(PyContains::py_contains(&(xs), &(x)))
}

pub fn has_key(d: FastMap<String, i64>, k: &str) -> Result<bool, RuntimeError> {
    Ok(PyContains::py_contains(&(d), &(k)))
}

pub fn has_member(s: FastSet<i64>, x: i64) -> Result<bool, RuntimeError> {
    Ok(PyContains::py_contains(&(s), &(x)))
}

pub fn has_substring(hay: &str, needle: &str) -> Result<bool, RuntimeError> {
    Ok(PyContains::py_contains(&(hay), &(needle)))
}

pub fn lacks_element(xs: Vec<i64>, x: i64) -> Result<bool, RuntimeError> {
    Ok(!(PyContains::py_contains(&(xs), &(x))))
}

pub fn replace_first(n: i64) -> Result<Vec<i64>, RuntimeError> {
    let mut xs: Vec<i64> = vec![0i64, 0i64, 0i64];
    {
        let __compylr_value = Clone::clone(&(n));
        let __compylr_index = 0i64;
        PySetItem::py_set(&mut (xs), &__compylr_index, __compylr_value)?;
    }
    Ok(xs)
}
