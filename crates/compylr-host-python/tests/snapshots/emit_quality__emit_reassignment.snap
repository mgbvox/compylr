//! Translated by compylr.

use crate::compat::{
    FastMap, FastSet, IndexOrigin, PyAdd, PyAddAssign, PyAddAssignAt, PyContains,
    PyIterate, PyLen, PyNum, PySetItem, RuntimeError, TextUnits, div_exact,
    py_borrow, py_place, py_subscript,
};

pub fn accumulate(limit: i64) -> Result<i64, RuntimeError> {
    let mut i: i64 = 0i64;
    let mut total: i64 = 0i64;
    while ((&(i)) < (&(limit))) {
        PyAddAssign::py_add_assign(&mut total, &(i))?;
        PyAddAssign::py_add_assign(&mut i, &(1i64))?;
    }
    Ok(total)
}

pub fn increment(mut n: i64) -> Result<i64, RuntimeError> {
    PyAddAssign::py_add_assign(&mut n, &(1i64))?;
    Ok(n)
}

pub fn widened() -> Result<f64, RuntimeError> {
    let mut x: f64 = 1.0f64;
    x = ((2i64) as f64);
    Ok(x)
}
