//! Translated by compylr.

use crate::compat::{
    FastMap, FastSet, IndexOrigin, PyAdd, PyAddAssign, PyAddAssignAt, PyContains,
    PyIterate, PyLen, PyNum, PySetItem, RuntimeError, TextUnits, div_exact,
    py_borrow, py_place, py_subscript,
};

pub fn f(a: i64) -> Result<i64, RuntimeError> {
    let b: i64 = helper(a)?;
    Ok(b)
}

pub fn forward(a: i64) -> Result<i64, RuntimeError> {
    Ok(later(a)?)
}

pub fn helper(n: i64) -> Result<i64, RuntimeError> {
    Ok(n)
}

pub fn later(a: i64) -> Result<i64, RuntimeError> {
    Ok(PyAdd::py_add(&(a), &(1i64))?)
}

pub fn promoted(a: i64) -> Result<f64, RuntimeError> {
    Ok(scale_float(((a) as f64))?)
}

pub fn scale_float(x: f64) -> Result<f64, RuntimeError> {
    Ok(PyNum::py_mul(&(x), &(2.0f64))?)
}
