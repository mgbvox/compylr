//! Translated by compylr.

use crate::compat::{
    FastMap, FastSet, IndexOrigin, PyAdd, PyAddAssign, PyAddAssignAt, PyContains,
    PyIterate, PyLen, PyNum, PySetItem, RuntimeError, TextUnits, div_exact,
    py_borrow, py_place, py_subscript,
};

pub fn build_list() -> Result<Vec<i64>, RuntimeError> {
    let xs: Vec<i64> = vec![1i64, 2i64, 3i64];
    Ok(xs)
}

pub fn characters(s: String) -> Result<i64, RuntimeError> {
    Ok(PyLen::py_len(&(s), TextUnits::CodePoints))
}

pub fn first_and_count(xs: Vec<i64>) -> Result<i64, RuntimeError> {
    let first: i64 = py_subscript(&(xs), &(0i64), IndexOrigin::FromEitherEnd)?;
    let count: i64 = PyLen::py_len(&(xs), TextUnits::CodePoints);
    Ok(PyAdd::py_add(&(first), &(count))?)
}

pub fn from_end(xs: Vec<i64>) -> Result<i64, RuntimeError> {
    Ok(py_subscript(&(xs), &(PyNum::py_neg(&(1i64))?), IndexOrigin::FromEitherEnd)?)
}

pub fn lookup(d: FastMap<String, i64>, key: String) -> Result<i64, RuntimeError> {
    Ok(py_subscript(&(d), &(key), IndexOrigin::FromEitherEnd)?)
}

pub fn mapping() -> Result<FastMap<String, i64>, RuntimeError> {
    Ok(FastMap::from_iter([(String::from("a"), 1i64), (String::from("b"), 2i64)]))
}

pub fn nested(d: FastMap<String, Vec<i64>>, key: String) -> Result<i64, RuntimeError> {
    let inner: Vec<i64> = py_subscript(&(d), &(key), IndexOrigin::FromEitherEnd)?;
    Ok(py_subscript(&(inner), &(0i64), IndexOrigin::FromEitherEnd)?)
}

pub fn pair() -> Result<String, RuntimeError> {
    let t: (i64, String) = (1i64, String::from("a"));
    Ok((t).1.clone())
}

pub fn unique() -> Result<FastSet<i64>, RuntimeError> {
    Ok(FastSet::from_iter([1i64, 2i64, 2i64]))
}
